NEXT_PUBLIC_FIREBASE_API_KEY=

# 本番の Vercel では、配信ドメインを authDomain に設定します
# 例: keihi-pocket.vercel.app
# ローカル開発では keihi-pocket.firebaseapp.com のままでも構いません
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ENABLE_CLOUD_IMAGES=false

# 広告を有効にするときに設定します
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_REPORTS_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SETTINGS=

# レシート読み取りの精度を上げたいときに設定します
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=

# 高精度読み取りを使う場合に設定します。未設定でも通常の読み取りと手入力は使えます
HIGH_ACCURACY_ENABLED=true
HIGH_ACCURACY_DAILY_LIMIT=3
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=

# 開発中だけ読み取り結果を画面で確認したいときに true にします
NEXT_PUBLIC_SHOW_RECEIPT_DEBUG=false
